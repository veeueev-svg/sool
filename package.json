{
  "name": "sool-digital-state",
  "version": "0.1.0",
  "private": true,
  "description": "التنفيذ المرجعي للدولة الملكية الفدرالية الرقمية — نواة السيادة والهوية والتدقيق",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=tap --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=dist/.tests.tap dist/tests/",
    "check:size": "bash scripts/check_module_size.sh",
    "check:criteria": "bash scripts/check_criteria_status.sh",
    "check:paths": "bash scripts/check_absolute_paths.sh",
    "check:declaration": "bash scripts/check_declaration.sh",
    "check:readers": "bash scripts/check_config_readers.sh",
    "check:numbers": "bash scripts/check_generated_numbers.sh",
    "check:closed-enums": "bash scripts/check_closed_enums.sh",
    "check:boot-work": "bash scripts/check_boot_work.sh",
    "check:confinement": "npm run build && node dist/scripts/check_confinement.js",
    "check:ci-gates": "bash scripts/check_ci_gates.sh",
    "check:work": "node scripts/check_work.mjs",
    "work:list": "node scripts/work.mjs list",
    "work:new": "node scripts/work.mjs new",
    "render:confinement": "npm run build && node dist/scripts/render_confinement.js",
    "verify": "npm run build && node --test --test-reporter=tap --test-reporter-destination=stdout --test-reporter=tap --test-reporter-destination=dist/.tests.tap dist/tests/ && node dist/scripts/verify_audit_chain.js && npm run check:size && npm run check:criteria && npm run check:paths && npm run check:declaration && npm run check:readers && npm run check:numbers && npm run check:closed-enums && npm run check:boot-work && npm run check:confinement && npm run check:ci-gates && npm run check:work",
    "bench": "tsc && node dist/scripts/bench_scale.js",
    "bench:tail": "npm run build && node dist/scripts/bench_scale_multi.js --runs 7",
    "bench:load": "tsc && node dist/scripts/bench_load.js",
    "bench:recovery": "npm run build && bash scripts/restore.sh --bench",
    "probe:compaction": "npm run build && node dist/scripts/compaction_probe.js 200",
    "probe:fiscal-scope": "npm run build && node dist/scripts/fiscal_scope_probe.js",
    "probe:governance-scope": "npm run build && node dist/scripts/governance_scope_probe.js",
    "probe:durability-scope": "npm run build && node dist/scripts/durability_scope_probe.js",
    "probe:journal-cost": "npm run build && node scripts/journal_cost_probe.mjs",
    "probe:declaration-scope": "npm run build && node dist/scripts/declaration_scope_probe.js",
    "probe:declaration-cost": "npm run build && node --expose-gc dist/scripts/declaration_cost_probe.js",
    "probe:declaration-reach": "npm run build && node dist/scripts/declaration_reach_probe.js",
    "probe:closed-enums": "npm run build && node dist/scripts/closed_enum_probe.js",
    "probe:confinement": "npm run build && node dist/scripts/confinement_probe.js",
    "probe:reproduction": "npm run build && node dist/scripts/reproduction_probe.js",
    "probe:inference": "npm run build && node dist/scripts/inference_probe.js",
    "probe:intent": "npm run build && node dist/scripts/intent_probe.js",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
