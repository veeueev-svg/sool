# infra/docker/Dockerfile — صورةُ الدولة الرقمية المتقشّفة
# المالك: وزارة الأمن السيبراني | المرحلة 39 (البند T-16 — إكمالُ المعيار C-09)
#
# لماذا: أعلن المدقّق في C-09 أن «المنعَ تطبيقيٌّ داخل العملية فقط». ومن أسبابِ ذلك أن
# الدولة لم تكن تُشحن في صورةٍ محصورة أصلًا: بلا صورةٍ متقشّفة، كلُّ شرطٍ في
# `config/confinement.yaml` يبقى دعوى. هذا الملف يُنشئ الحصرَ، و`src/security/confinement.ts`
# يشهد عليه من `/proc` بعد الإقلاع. الاثنان لازمان: من يُنشئ لا يشهد لنفسه (RULE-004).
#
# ثوابت هذه الصورة:
#   1) لا صدفةَ ولا مُدير حزم في طور التشغيل — من دخل الحاوية لا يجد أداةً يتوسّع بها
#   2) لا تبعيات وقت تشغيل (المشروع بصفر تبعيات) — فلا `node_modules` في الطور الأخير
#   3) المستخدمُ غيرُ الجذر برقمٍ ثابت معلن (10001)، مطابقٌ لـ `infra/docker/compose.yaml`
#   4) الشيفرةُ المشحونة هي `dist/` المبنيّة، لا `src/` — فلا مُصرِّف في الإنتاج
#
# البناء (من جذر المستودع):
#   docker build -f infra/docker/Dockerfile -t sool-digital-state:latest .
# التشغيل: لا يدويًّا — `docker compose -f infra/docker/compose.yaml up`
# فالوصفُ هناك هو من يُسقط القدرات ويمنع الخروج، والصورةُ وحدها لا تفعل ذلك.

# ── الطور الأول: البناء. يُصرَّف هنا وحده، ولا شيء منه يُشحن إلا `dist/`.
FROM node:20-bookworm-slim AS build
WORKDIR /build
COPY package.json package-lock.json tsconfig.json ./
COPY src ./src
COPY tests ./tests
COPY scripts ./scripts
# المُصرِّفُ (tsc) تبعيةُ تطويرٍ لا تشغيلٍ — يُثبَّت هنا في طور البناء وحده، ولا
# شيءَ منه يُشحن. والمشروعُ بصفرِ تبعياتِ تشغيل، فلا `node_modules` في الطور الأخير.
RUN npm ci
RUN npm run build

# ── الطور الثاني: التشغيل. صورةٌ بلا مُدير حزم وبلا صدفة (ثابت 1).
# `distroless/nodejs20` نقطةُ دخولها `node` نفسه، فلا `sh -c` بينها وبين العمليّة.
FROM gcr.io/distroless/nodejs20-debian12:nonroot AS runtime

# ثابت 3: الرقمُ معلن ومطابقٌ لوصف التشغيل. `nonroot` في هذه الصورة هو 65532،
# ويُبدَّل صراحةً إلى 10001 ليكون واحدًا في الصورة والوصف والقياس بلا اجتهاد.
USER 10001:10001
WORKDIR /app

# ثابت 4: المشحونُ هو المبنيُّ وحده — ولا `src/` ولا `tsconfig.json` في الإنتاج.
COPY --from=build --chown=10001:10001 /build/dist ./dist
# التهيئةُ تُشحن للقراءة فقط: السياسةُ تُقرأ ولا تُكتب (RULE-005).
COPY --chown=10001:10001 config ./config
# منشوراتُ الحصر تُشحن معها ليُقابلها المُشغِّل بما هو مُطبَّق فعلًا عند الحادث.
COPY --chown=10001:10001 infra/network-policy ./infra/network-policy

# اليوميّةُ الدائمة (T-120) — المسارُ نفسُه المعلن في `config/persistence.yaml`.
# يُركَّب حجمًا في وصف التشغيل؛ وبلا تركيبٍ يفشل الإقلاع مغلقًا لا يمرّ بلا ثبات.
VOLUME ["/var/lib/sool"]

# لا منفذَ مكشوف: الدولةُ لا تُصغي إلى الخارج في هذا الطور، والخروجُ ممنوع افتراضًا.
# من احتاج منفذًا فليعلنه في التهيئة أولًا — لا في هذا الملف (RULE-005).

ENV NODE_ENV=production
ENTRYPOINT ["/nodejs/bin/node", "dist/src/index.js"]
